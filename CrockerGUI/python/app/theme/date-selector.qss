QDateEdit {
    background: #152238;
    color: #e2edf9;
    border: 1px solid #405674;
    border-radius: 8px;
    min-height: 28px;
    padding: 5px 38px 5px 12px;
    font-family: "Segoe UI";
    font-size: 13px;
    selection-background-color: #254b78;
    selection-color: white;
}
QDateEdit:hover { background: #1b2d47; border-color: #6587b0; }
QDateEdit:focus { border-color: #7aade5; }
QDateEdit::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 32px;
    border: none;
    border-left: 1px solid #405674;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background: #1e324d;
}
QDateEdit::down-arrow { image: url("__CHEVRON_PATH__"); width: 16px; height: 16px; }
QCalendarWidget QWidget { background: #111c30; color: #e2edf9; }
QCalendarWidget QToolButton {
    background: #1e324d;
    color: #e2edf9;
    border: none;
    border-radius: 5px;
    padding: 7px;
    font-family: "Segoe UI";
    font-size: 13px;
}
QCalendarWidget QToolButton:hover { background: #29466a; }
QCalendarWidget QAbstractItemView {
    background: #111c30;
    alternate-background-color: #17263c;
    color: #e2edf9;
    selection-background-color: #315d8b;
    selection-color: #ffffff;
    border: none;
    outline: 0;
    font-family: "Segoe UI";
    font-size: 13px;
}
QCalendarWidget QMenu { background: #152238; color: #e2edf9; border: 1px solid #405674; }
QCalendarWidget QMenu::item { padding: 6px 14px; }
QCalendarWidget QMenu::item:selected { background: #254b78; }
