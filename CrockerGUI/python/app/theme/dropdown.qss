QAbstractItemView {
    background: #111315;
    color: #e6e7e9;
    border: 1px solid #41444a;
    border-radius: 8px;
    padding: 5px;
    outline: 0;
    selection-background-color: #3c3f45;
    selection-color: #ffffff;
}
QAbstractItemView::item {
    min-height: 26px;
    padding: 5px 12px;
    margin: 2px 0;
    border: 1px solid transparent;
    border-radius: 5px;
}
QAbstractItemView::item:hover {
    background: #292c31;
    color: #ffffff;
}
QAbstractItemView::item:selected {
    background: #3c3f45;
    border-color: #858a94;
    color: #ffffff;
}
QAbstractItemView::item:disabled { color: #64748b; }
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 3px 0;
}
QScrollBar::handle:vertical {
    background: #41444a;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #858a94; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
