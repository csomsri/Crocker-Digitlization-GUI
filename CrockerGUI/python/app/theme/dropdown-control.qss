QComboBox {
    background-color: #111315;
    color: #e6e7e9;
    border: 1px solid #41444a;
    border-radius: 8px;
    min-height: 28px;
    padding: 5px 42px 5px 12px;
    font-family: "Segoe UI";
    font-size: 13px;
}
QComboBox:hover {
    background-color: #23262a;
    border-color: #858a94;
}
QComboBox:focus, QComboBox:on {
    background-color: #23262a;
    border-color: #a4a8b0;
    color: #ffffff;
}
QComboBox:disabled {
    background-color: #1c1e22;
    border-color: #303238;
    color: #80858e;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 32px;
    border: none;
    border-left: 1px solid #41444a;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: #292c31;
}
QComboBox::drop-down:hover { background-color: #3c3f45; }
QComboBox::down-arrow {
    image: url("__CHEVRON_PATH__");
    width: 16px;
    height: 16px;
}
