QComboBox {
    background-color: #152238;
    color: #e2edf9;
    border: 1px solid #405674;
    border-radius: 8px;
    min-height: 28px;
    padding: 5px 42px 5px 12px;
    font-family: "Segoe UI";
    font-size: 13px;
}
QComboBox:hover {
    background-color: #1b2d47;
    border-color: #6587b0;
}
QComboBox:focus, QComboBox:on {
    background-color: #1b2d47;
    border-color: #7aade5;
    color: #ffffff;
}
QComboBox:disabled {
    background-color: #111b2b;
    border-color: #2c3b50;
    color: #728197;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 32px;
    border: none;
    border-left: 1px solid #405674;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: #1e324d;
}
QComboBox::drop-down:hover { background-color: #29466a; }
QComboBox::down-arrow {
    image: url("__CHEVRON_PATH__");
    width: 16px;
    height: 16px;
}
